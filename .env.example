# Run configure.py to generate the private server key. It is never entered in the dashboard.
APP_API_TOKEN=replace-with-a-long-private-token
SPREE_MODE=fixture
STORE_ID=demo-store
SPREE_BASE_URL=http://localhost:3000
# Server-only secret; live mode needs read_orders, read_fulfillments and read_products.
SPREE_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
EMBEDDING_MODEL=nomic-embed-text:latest
LOCAL_DEMO_ACCESS=true
# Optional default selection for your own store; leave blank to enter it in the UI.
DEFAULT_ORDER_REFERENCE=
# Optional DATA_DIR, otherwise ./data relative to this project.
